# Copy to backend/.env. Never put service-role keys in NEXT_PUBLIC_* variables.
HOST=127.0.0.1
PORT=3001
AUTH_ORIGIN=http://127.0.0.1:3010
CHAIN_ID=5042002

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RPC_URL=

# V1/V2 defaults come from contract/deployments/arc-testnet.json.
FACTORY_V1_ADDRESS=0xdae395f504be412ddfc0646b37ac1840a1462c08
FACTORY_V2_ADDRESS=0x92f357b256f5fb6a0f7e635a29462601c1cb6547

# Optional: only verified deployments matching current source.
FACTORY_V3_ADDRESS=
AGENT_REGISTRY_ADDRESS=
PROVIDER_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
DISPUTE_VAULT_ADDRESS=
