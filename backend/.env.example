# Copy to backend/.env. Never put service-role keys in NEXT_PUBLIC_* variables.
HOST=127.0.0.1
PORT=3001
AUTH_ORIGIN=http://127.0.0.1:3010
CHAIN_ID=5042002

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Required for provider-enforced daily policy reservations. Generate a dedicated
# 32-byte key locally; this signer never controls customer funds or provider gas.
POLICY_AUTHORITY_PRIVATE_KEY=
# Empty uses the four official Arc Testnet public RPCs with automatic failover.
# Optional ordered comma-separated override (RPC_URL still supports one URL).
RPC_URLS=
RPC_URL=
# Optional paid fallback. Leave RPC_URLS/RPC_URL blank to try public RPCs first.
# Used last, only when the preceding endpoints fail or are cooling down.
ALCHEMY_RPC_URL=

# Empty addresses resolve the canonical release in contract/deployments/arc-testnet.json.
# Historical factories remain readable; do not delete deployment history.
FACTORY_V1_ADDRESS=
FACTORY_V2_ADDRESS=

# Optional overrides: only verified deployments matching the intended ABI.
FACTORY_V3_ADDRESS=
AGENT_REGISTRY_ADDRESS=
PROVIDER_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
DISPUTE_VAULT_ADDRESS=

# Optional internal dispute assistant. Never expose these as NEXT_PUBLIC variables.
DISPUTE_AI_BASE_URL=https://openrouter.ai/api/v1
DISPUTE_AI_MODEL=
DISPUTE_AI_API_KEY=

# Hosted built-in APIs. Generate a 32-byte hex key locally; keep a secure backup.
# Losing/changing this key prevents access to existing hosted provider signers.
MANAGED_PROVIDER_ENCRYPTION_KEY=
# Set a public HTTPS origin before publishing hosted APIs to the Directory.
# Defaults to http://127.0.0.1:3001 for local development.
MANAGED_API_BASE_URL=
# Required in production: absolute path on a persistent volume (Railway: /data/x402).
# Run one backend replica; keep this volume across redeploys.
X402_STORAGE_DIR=
