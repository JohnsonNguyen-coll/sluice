# Optional canonical site origin; use your production URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public read-only Arc Testnet RPC. Never put secret RPC credentials here.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
# Explicit factory for future write actions. Leave unset to show the missing-config state.
# NEXT_PUBLIC_FACTORY_ADDRESS=0x...

# Public Reown project ID for RainbowKit WalletConnect/QR. Not a private key.
# Extension wallets still work when this is empty. Rebuild/restart after changing it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
