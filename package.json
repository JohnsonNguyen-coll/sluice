{
  "name": "sluice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "frontend",
    "backend",
    "contract",
    "backend/packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd frontend start",
    "lint": "bun run --cwd frontend lint",
    "typecheck": "bun run --cwd frontend typecheck",
    "check": "bun run lint && bun run typecheck",
    "test:routes": "bun run --cwd frontend test:routes",
    "contracts:build": "bun run --cwd contract build",
    "contracts:test": "bun run --cwd contract test",
    "deploy:self": "bun run --cwd contract deploy:self",
    "compass:deploy": "bun run --cwd contract compass:deploy",
    "fetch:abi": "bun run --cwd frontend fetch:abi",
    "backend:dev": "bun run --cwd backend dev",
    "backend:start": "bun run --cwd backend start",
    "backend:check": "bun run --cwd backend check",
    "protocol:check": "bun run --cwd backend/packages/sdk check && bun run --cwd backend/packages/middleware check",
    "deploy:phase3": "bun run --cwd contract deploy:phase3",
    "test:e2e:local": "bun run contract/scripts/phase3-local-e2e.ts"
  },
  "overrides": {
    "viem": "2.57.5"
  }
}
