{
  "name": "sluice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "contract"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd frontend start",
    "lint": "bun run --cwd frontend lint",
    "typecheck": "bun run --cwd frontend typecheck",
    "check": "bun run lint && bun run typecheck",
    "test:routes": "bun run --cwd frontend test:routes",
    "contracts:build": "bun run --cwd contract build",
    "contracts:test": "bun run --cwd contract test",
    "deploy:self": "bun run --cwd contract deploy:self",
    "compass:deploy": "bun run --cwd contract compass:deploy",
    "fetch:abi": "bun run --cwd frontend fetch:abi"
  },
  "overrides": {
    "viem": "2.57.5"
  }
}
